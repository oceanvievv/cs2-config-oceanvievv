      "gameFiles": {
        "autoexec.cfg": "// CS2 runs this file automatically on startup.\r\n// It stays tiny on purpose - it just chains to the real config,\r\n// so there is only one place to edit.\r\n\r\nexec oceanvievv\r\n\r\n// Force the settings above to be written to disk so they survive\r\n// the next time CS2 saves its own config.\r\nhost_writeconfig\r\n\r\n// ---- added by cs2-config ----\r\nexec crosshair\r\nhost_writeconfig\r\n",
        "crosshair.cfg": "// Migrated from the saved pre-September-2026 crosshair at 1440x1080.\r\n// Pixel dimensions are a calculated match; check the appearance in CS2.\r\n// Color preset 4 was cyan; the old custom RGB values were not active.\r\n\r\ncl_crosshairstyle \"4\"\r\ncl_crosshair_length \"4\"\r\ncl_crosshair_thickness \"1\"\r\ncl_crosshair_gap \"2\"\r\ncl_crosshair_drawoutline \"2\"\r\ncl_crosshairoutline_r \"0\"\r\ncl_crosshairoutline_g \"0\"\r\ncl_crosshairoutline_b \"0\"\r\ncl_crosshairoutline_a \"255\"\r\ncl_crosshair_dynamic_maxdist_splitratio \"0.3\"\r\ncl_crosshair_dynamic_splitalpha_innermod \"1\"\r\ncl_crosshair_dynamic_splitalpha_outermod \"0.5\"\r\ncl_crosshair_dynamic_splitdist \"7\"\r\ncl_crosshair_recoil \"false\"\r\ncl_crosshair_sniper_width \"1\"\r\ncl_crosshair_t \"false\"\r\ncl_crosshaircolor_a \"255\"\r\ncl_crosshaircolor_b \"250\"\r\ncl_crosshaircolor_g \"250\"\r\ncl_crosshaircolor_r \"50\"\r\ncl_crosshairdot \"false\"\r\n// Set after the size commands: editing size updates the reference height.\r\ncl_crosshair_screen_height \"1080\"\r\n",
        "knife.cfg": "mp_drop_knife_enable true\r\nsubclass_create 508\r\n\r\necho Knife dropped\r\n",
        "oceanvievv.cfg": "bind \"mwheelup\" \"switchhands\"\r\nbind \"mwheeldown\" \"+jump\"\r\n\r\nbind \"scancode86\" \"volume 0.01\"\r\nbind \"scancode87\" \"volume 0.25\"\r\n\r\nbind \"scancode89\" \"buy vesthelm; buy vest\"\r\nbind \"scancode90\" \"buy ak47; buy m4a1_silencer\"\r\nbind \"scancode91\" \"buy defuser\"\r\nbind \"scancode92\" \"buy awp\"\r\nbind \"scancode93\" \"buy deagle\"\r\nbind \"scancode94\" \"buy molotov; buy incgrenade\"\r\nbind \"scancode95\" \"buy smokegrenade\"\r\nbind \"scancode96\" \"buy flashbang\"\r\nbind \"scancode97\" \"buy hegrenade\"\r\n\r\nbind \"mouse4\" \"slot7\"\r\nbind \"mouse5\" \"slot8\"\r\n\r\nbind \"scancode65\" \"exec training\"\r\nbind \"scancode66\" \"exec knife\"\r\n\r\nvolume \"0.1\"\r\nbind \"scancode226\" \"+voicerecord\"\r\n\r\nbind \"z\" \"radio1\"\r\nbind \"x\" \"radio2\"\r\nbind \"c\" \"radio3\"\r\n\r\nsensitivity \"2.2\"\r\nzoom_sensitivity_ratio \"1.0\"\r\n\r\nviewmodel_fov 68; \r\nviewmodel_offset_x 2.5\r\nviewmodel_offset_y 0\r\nviewmodel_offset_z -1.5\r\nviewmodel_presetpos 3\r\n\r\necho Config loaded\r\n",
        "training.cfg": "// General\r\nbot_kick\r\nmp_warmup_end\r\nsv_cheats true\r\nmp_limitteams 0\r\nmp_autoteambalance 0\r\n\r\n// Economy\r\nmp_maxmoney 60000\r\nmp_startmoney 60000\r\nmp_buytime 9999\r\nmp_buy_anywhere 1\r\n\r\n// Round settings\r\nmp_freezetime 0\r\nmp_roundtime 60\r\nmp_roundtime_defuse 60\r\nmp_restartgame 1\r\n\r\n// Respawn\r\nmp_respawn_on_death_ct 1\r\nmp_respawn_on_death_t 1\r\n\r\n// Practice / visuals\r\nsv_infinite_ammo 1\r\nsv_showimpacts 1\r\nsv_showimpacts_time 10\r\nammo_grenade_limit_total 5\r\nsv_grenade_trajectory_prac_pipreview 1\r\n\r\n// Binds\r\nbind alt \"noclip\"\r\nbind \"CAPSLOCK\" \"sv_rethrow_last_grenade\"\r\nbind \"MOUSE3\" \"ent_fire smokegrenade_projectile kill; ent_fire molotov_projectile kill; ent_fire flashbang_projectile kill; ent_fire hegrenade_projectile kill; ent_fire decoy_projectile kill; ent_fire inferno kill; stopsound\"\r\n\r\necho Training mode activated\r\n"
      },
